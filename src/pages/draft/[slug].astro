---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import { readingTime } from '../../lib/posts';

export async function getStaticPaths() {
	const entries = await getCollection('drafts');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const wordCount = (entry.body ?? '')
	.replace(/^---[\s\S]*?---/, '')
	.trim()
	.split(/\s+/)
	.filter(Boolean).length;

function formatDate(iso: string): string {
	const d = new Date(iso);
	return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}
---

<Base
	title={`[DRAFT] ${entry.data.title}`}
	description={entry.data.summary ?? ''}
	path={`/draft/${entry.id}`}
	type="article"
>
	<meta name="robots" content="noindex,nofollow" slot="head" />

	<main class="mx-auto max-w-3xl px-6 py-16">
		<div
			class="mb-10 rounded-md px-4 py-3 text-sm"
			style="background: rgba(220,140,0,0.10); border: 1px solid rgba(220,140,0,0.45); color: var(--color-text);"
		>
			<strong>DRAFT preview</strong> — not published. Hidden from search, sitemap, RSS, and listings. The live
			version will be served at <code>/posts/{entry.id}</code>.
		</div>

		<nav class="mb-12">
			<a href="/drafts" class="text-sm transition-colors" style="color: var(--color-text-muted);">← all drafts</a>
		</nav>

		<header class="mb-10" style="border-bottom: 1px solid var(--color-border); padding-bottom: 2rem;">
			<h1 class="text-3xl font-semibold tracking-tight" style="color: var(--color-text);">
				{entry.data.title}
			</h1>
			<div class="mt-3 flex items-center gap-2.5 text-xs" style="color: var(--color-text-muted);">
				<time datetime={entry.data.created}>{formatDate(entry.data.created)}</time>
				<span>·</span>
				<span>{readingTime(wordCount)}</span>
				{
					entry.data.tags.length > 0 && (
						<>
							<span>·</span>
							<span>{entry.data.tags.join(', ')}</span>
						</>
					)
				}
			</div>
		</header>

		<article
			class="prose prose-zinc dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight max-w-none prose-lg prose-p:leading-relaxed"
			style="font-family: var(--font-sans); --tw-prose-body: var(--color-text); --tw-prose-headings: var(--tw-prose-invert-headings, #dedad5);"
		>
			<Content />
		</article>
	</main>
	<ImageZoom />
</Base>
