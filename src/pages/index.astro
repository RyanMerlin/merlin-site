---
import Base from '../layouts/Base.astro';
import TopicFilter, { type FilterItem } from '../components/TopicFilter.tsx';
import { getPosts, topics, postTopic, postsByTopic, postThumbnail } from '../lib/posts';

const posts = await getPosts();

const items: FilterItem[] = posts.map((p) => {
	const topic = postTopic(p);
	return {
		slug: p.slug,
		title: p.title,
		created: p.created,
		summary: p.summary,
		tags: p.tags,
		wordCount: p.wordCount,
		topicSlug: topic?.slug ?? null,
		topicLabel: topic?.label ?? null,
		topicColor: topic?.color ?? null,
		thumbnailSrc: postThumbnail(p).src
	};
});

const visibleTopics = topics.filter((t) => postsByTopic(posts, t.slug).length > 0);
---

<Base
	path="/"
	title="AI Agents & Infrastructure"
	description="Ryan Merlin, Engineer building production enterprise AI systems for Fortune 100 companies. The model was never the hard part."
>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="text-3xl font-semibold tracking-tight" style="color: var(--color-text);">Ryan Merlin</h1>
			<p class="mt-3 text-base leading-relaxed" style="color: var(--color-text-muted);">
				I build production enterprise AI systems for Fortune 100 companies.<br />The model was never the hard part.
			</p>
		</header>

		<TopicFilter client:load items={items} topics={visibleTopics} />
	</main>
</Base>
