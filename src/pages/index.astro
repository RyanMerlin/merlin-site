---
import Base from '../layouts/Base.astro';
import TopicFilter, { type FilterItem } from '../components/TopicFilter.tsx';
import { getPosts, topics, postTopic, postsByTopic } from '../lib/posts';

const posts = await getPosts();

const items: FilterItem[] = posts.map((p) => {
	const topic = postTopic(p);
	return {
		slug: p.slug,
		title: p.title,
		created: p.created,
		summary: p.summary,
		wordCount: p.wordCount,
		topicSlug: topic?.slug ?? null,
		topicLabel: topic?.label ?? null,
		topicColor: topic?.color ?? null
	};
});

const visibleTopics = topics.filter((t) => postsByTopic(posts, t.slug).length > 0);
---

<Base
	path="/"
	title="AI Agents & Infrastructure"
	description="Ryan Merlin on production AI agent systems: control planes, persistent sessions, and the infrastructure decisions practitioners actually face."
>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="text-3xl font-semibold tracking-tight" style="color: var(--color-text);">Ryan Merlin</h1>
		</header>

		<TopicFilter client:load items={items} topics={visibleTopics} />
	</main>
</Base>
