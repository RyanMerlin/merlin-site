---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PostCta from '../../components/PostCta.astro';
import ImageZoom from '../../components/ImageZoom.astro';
import { getPosts, relatedPosts, metaDescription, postThumbnail } from '../../lib/posts';
import { formatDate, readingTime } from '../../lib/format';
import { SITE_URL, SITE_AUTHOR } from '../../lib/config';

export async function getStaticPaths() {
	const entries = await getCollection('posts', (e) => !e.data.status || e.data.status === 'published');
	return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

const allPosts = await getPosts();
const meta = allPosts.find((p) => p.slug === entry.id)!;
const otherPosts = relatedPosts(allPosts, meta, 2);

const ogImage = `${SITE_URL}${postThumbnail(meta).src}`;
const description = metaDescription(entry.data);

const jsonLd = JSON.stringify({
	'@context': 'https://schema.org',
	'@type': 'Article',
	headline: meta.title,
	description,
	url: `${SITE_URL}/posts/${meta.slug}`,
	datePublished: meta.created,
	dateModified: meta.created,
	author: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_URL },
	publisher: { '@type': 'Person', name: SITE_AUTHOR, url: SITE_URL },
	keywords: meta.tags,
	wordCount: meta.wordCount
});
---

<Base
	title={meta.title}
	description={description}
	path={`/posts/${meta.slug}`}
	type="article"
	publishedTime={meta.created}
	image={ogImage}
>
	<script type="application/ld+json" slot="head" set:html={jsonLd} />

	<main class="reading px-6 py-16">
		<div class="reading-col">
		<nav class="mb-12">
			<a href="/" class="text-sm transition-colors" style="color: var(--color-text-muted);">← writing</a>
		</nav>

		<header class="mb-10" style="border-bottom: 1px solid var(--color-border); padding-bottom: 2rem;">
			<h1 class="text-3xl font-semibold tracking-tight" style="color: var(--color-text);">
				{meta.title}
			</h1>
			<div class="mt-3 flex items-center gap-2.5 text-xs" style="color: var(--color-text-muted);">
				<time datetime={meta.created}>{formatDate(meta.created, 'long')}</time>
				<span>·</span>
				<span>{readingTime(meta.wordCount)}</span>
				{
					meta.tags.length > 0 && (
						<>
							<span>·</span>
							<span>{meta.tags.join(', ')}</span>
						</>
					)
				}
			</div>
		</header>

		{
			toc.length > 0 && (
				<details class="toc-mobile">
					<summary>On this page</summary>
					<ul>
						{toc.map((h) => (
							<li>
								<a href={`#${h.slug}`} class={h.depth === 3 ? 'depth-3' : undefined}>
									{h.text}
								</a>
							</li>
						))}
					</ul>
				</details>
			)
		}

		<article
			class="prose prose-zinc dark:prose-invert prose-headings:font-semibold prose-headings:tracking-tight max-w-none prose-lg prose-p:leading-relaxed"
			style="font-family: var(--font-sans); --tw-prose-body: var(--color-text); --tw-prose-headings: var(--color-heading);"
		>
			<Content />
		</article>

		<PostCta />

		{
			otherPosts.length > 0 && (
				<div class="mt-8 pt-8" style="border-top: 1px solid var(--color-border);">
					<p class="text-xs font-medium uppercase tracking-widest mb-6" style="color: var(--color-text-muted);">
						Related
					</p>
					<ul class="space-y-4">
						{otherPosts.map((post) => (
							<li>
								<a href={`/posts/${post.slug}`} class="text-sm" style="color: var(--color-text);">
									{post.title}
								</a>
							</li>
						))}
					</ul>
				</div>
			)
		}
		</div>

		{
			toc.length > 0 && (
				<nav class="reading-toc" aria-label="Table of contents">
					<p class="toc-cap">On this page</p>
					<ul>
						{toc.map((h) => (
							<li>
								<a href={`#${h.slug}`} class={h.depth === 3 ? 'depth-3' : undefined}>
									{h.text}
								</a>
							</li>
						))}
					</ul>
				</nav>
			)
		}
	</main>
	<ImageZoom />
</Base>

<script>
	const links = [...document.querySelectorAll('.reading-toc a, .toc-mobile a')];
	const linkId = (a: Element) => (a.getAttribute('href') || '').slice(1);
	// Move focus to the target heading on click, so keyboard/screen-reader
	// users land inside the section rather than staying on the TOC link.
	links.forEach((a) =>
		a.addEventListener('click', () => {
			const el = document.getElementById(linkId(a));
			if (el) {
				el.setAttribute('tabindex', '-1');
				el.focus({ preventScroll: true });
			}
		})
	);
	const heads = [...document.querySelectorAll('.prose h2[id], .prose h3[id]')] as HTMLElement[];
	if (heads.length) {
		let currentId: string | null = null;
		const setActive = (id: string) => {
			if (id === currentId) return;
			currentId = id;
			links.forEach((a) => {
				const on = linkId(a) === id;
				a.classList.toggle('active', on);
				if (on) a.setAttribute('aria-current', 'location');
				else a.removeAttribute('aria-current');
			});
		};
		const visible = new Set<string>();
		const update = () => {
			let id: string | undefined;
			if (visible.size) {
				// the topmost currently-visible heading, in document order
				id = heads.find((h) => visible.has(h.id))?.id;
			} else {
				// nothing in the active band: fall back to the last heading scrolled past
				for (const h of heads) {
					if (h.getBoundingClientRect().top < 120) id = h.id;
					else break;
				}
				id = id || heads[0].id;
			}
			if (id) setActive(id);
		};
		const obs = new IntersectionObserver(
			(entries) => {
				for (const e of entries) {
					const el = e.target as HTMLElement;
					if (e.isIntersecting) visible.add(el.id);
					else visible.delete(el.id);
				}
				update();
			},
			{ rootMargin: '-90px 0px -70% 0px', threshold: 0 }
		);
		heads.forEach((h) => obs.observe(h));
		update();
	}
</script>
