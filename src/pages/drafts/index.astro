---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';

const drafts = (await getCollection('drafts')).sort((a, b) =>
	(b.data.created ?? '').localeCompare(a.data.created ?? '')
);
---

<Base title="Drafts" description="Unpublished drafts (hidden)" path="/drafts">
	<meta name="robots" content="noindex,nofollow" slot="head" />

	<main class="mx-auto max-w-3xl px-6 py-16">
		<h1 class="text-3xl font-semibold tracking-tight" style="color: var(--color-text);">Drafts</h1>
		<p class="mt-2 text-sm" style="color: var(--color-text-muted);">
			Unpublished previews. Hidden from search, sitemap, RSS, and listings.
		</p>

		{
			drafts.length === 0 ? (
				<p class="mt-10 text-sm" style="color: var(--color-text-muted);">
					No drafts staged.
				</p>
			) : (
				<ul class="mt-10 space-y-5">
					{drafts.map((d) => (
						<li>
							<a href={`/draft/${d.id}`} class="text-base font-medium" style="color: var(--color-text);">
								{d.data.title}
							</a>
							<div class="mt-1 text-xs" style="color: var(--color-text-muted);">
								{d.data.created} · {d.data.status ?? 'draft'} · /draft/{d.id}
							</div>
						</li>
					))}
				</ul>
			)
		}
	</main>
</Base>
