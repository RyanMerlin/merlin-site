---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_URL, SITE_TITLE, SITE_DESCRIPTION, TWITTER_HANDLE } from '../lib/config';

interface Props {
	title?: string;
	description?: string;
	path?: string;
	type?: string;
	image?: string;
	imageAlt?: string;
	publishedTime?: string;
}

const {
	title = '',
	description = SITE_DESCRIPTION,
	path = '/',
	type = 'website',
	image = `${SITE_URL}/og-default.png`,
	imageAlt = description,
	publishedTime = ''
} = Astro.props;

// Derived from the image URL itself, not passed as a separate prop — real hero
// art is served as .jpg (compressed), the satori-generated card as .png. Basing
// this on the URL's own extension means a caller can never pass a type that
// disagrees with what's actually served.
const imageType = /\.jpe?g(\?|$)/i.test(image) ? 'image/jpeg' : 'image/png';

// Brand the title with the site name, but drop the " · Ryan Merlin" suffix when it
// would push the tag past Bing's 65-char limit (the standalone title is enough).
const combinedTitle = title ? `${title} · ${SITE_TITLE}` : SITE_TITLE;
const fullTitle = combinedTitle.length > 65 && title ? title : combinedTitle;
const url = `${SITE_URL}${path}`;
---

<!doctype html>
<html lang="en" class="h-full dark">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="text-scale" content="scale" />
		<!-- Theme: dark by default; honor a stored light preference before paint (no flash) -->
		<script is:inline>
			if (localStorage.getItem('theme') === 'light') {
				document.documentElement.classList.remove('dark');
			}
		</script>
		<!-- Google Analytics -->
		<script async src="https://www.googletagmanager.com/gtag/js?id=G-NFQJWLV76P"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag() {
				dataLayer.push(arguments);
			}
			gtag('js', new Date());
			gtag('config', 'G-NFQJWLV76P');
		</script>

		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={url} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="alternate" type="application/rss+xml" title="Ryan Merlin" href="/feed.xml" />

		<meta property="og:type" content={type} />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={url} />
		<meta property="og:image" content={image} />
		<meta property="og:image:alt" content={imageAlt} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content={imageType} />
		<meta property="og:site_name" content={SITE_TITLE} />
		{publishedTime && <meta property="article:published_time" content={publishedTime} />}

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={TWITTER_HANDLE} />
		<meta name="twitter:creator" content={TWITTER_HANDLE} />
		<meta name="twitter:title" content={fullTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={image} />
		<meta name="twitter:image:alt" content={imageAlt} />

		<slot name="head" />
	</head>
	<body class="h-full">
		<Nav />
		<div class="flex-1 overflow-y-auto">
			<slot />
			<Footer />
		</div>
	</body>
</html>
