>
	<div class="mx-auto max-w-3xl px-6 flex flex-wrap items-center justify-center gap-4">
		<span>© {year} Ryan Merlin</span>
		<span>·</span>
		<a href="/feed.xml" style="color: var(--color-text-muted);" class="hover:underline">RSS</a>
		<span>·</span>
		<a href="https://github.com/RyanMerlin" target="_blank" rel="noopener noreferrer" style="color: var(--color-text-muted);" class="hover:underline">GitHub</a>
		<span>·</span>
		<a href="https://linkedin.com/in/ryanmerlin" target="_blank" rel="noopener noreferrer" style="color: var(--color-text-muted);" class="hover:underline">LinkedIn</a>
